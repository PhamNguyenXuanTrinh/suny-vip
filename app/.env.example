# Run backend.scripts.setup_local to create a private .env.local with a generated JWT secret.
SUNNY_JWT_SECRET=
SUNNY_ERP_DB=runtime/database/sunny.sqlite3
SUNNY_UPLOAD_DIR=runtime/uploads
SUNNY_ALLOWED_ORIGINS=http://127.0.0.1:8765
SUNNY_ALERT_INTERVAL_SECONDS=300
SUNNY_RECEIPT_SPIKE_THRESHOLDS={}
# Deferred until explicitly configured; never put this key in frontend code.
OPENAI_API_KEY=
SUNNY_OPENAI_MODEL=gpt-4o
SUNNY_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
